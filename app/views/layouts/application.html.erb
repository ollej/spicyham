<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= content_for?(:title) ? yield(:title) : 'Spicyham' %></title>
    <%= csrf_meta_tags %>

    <%= favicon_link_tag asset_path('apple-touch-icon-144x144-precomposed.png'), :rel => 'apple-touch-icon-precomposed', :type => 'image/png', :sizes => '144x144' %>
    <%= favicon_link_tag asset_path('apple-touch-icon-114x114-precomposed.png'), :rel => 'apple-touch-icon-precomposed', :type => 'image/png', :sizes => '114x114' %>
    <%= favicon_link_tag asset_path('apple-touch-icon-72x72-precomposed.png'), :rel => 'apple-touch-icon-precomposed', :type => 'image/png', :sizes => '72x72' %>
    <%= favicon_link_tag asset_path('apple-touch-icon-precomposed.png'), :rel => 'apple-touch-icon-precomposed', :type => 'image/png' %>
    <%= favicon_link_tag asset_path('favicon.ico'), :rel => 'shortcut icon' %>

    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>
  <body class="bg-gray-900 text-gray-100">
    <nav class="bg-gray-800 shadow-sm py-2" data-controller="toggle">
      <div class="max-w-7xl mx-auto px-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center">
            <button type="button" class="md:hidden mr-2 text-gray-400" data-action="click->toggle#toggle">
              &#x2630;
            </button>
            <a class="inline-flex items-center gap-1 text-xl font-bold text-purple-400" href="<%= root_path %>">
              <span class="text-amber-700"><%= icon("ham", height: 24) %></span> Spicyham
            </a>
          </div>
          <div class="hidden md:flex space-x-1" data-toggle-target="menu">
            <%= render partial: 'layouts/links', locals: { item_class: 'px-3 py-2 text-sm text-gray-300 hover:text-white hover:bg-gray-700 rounded' } %>
          </div>
        </div>
        <div class="hidden md:hidden flex-col gap-1 pt-2 border-t border-gray-700 mt-2" data-toggle-target="mobileMenu">
          <%= render partial: 'layouts/links', locals: { item_class: 'block px-3 py-2 text-sm text-gray-300 hover:text-white hover:bg-gray-700 rounded' } %>
        </div>
      </div>
    </nav>

    <div class="max-w-7xl mx-auto px-4 mt-2 lg:mt-4">
      <div class="flex flex-col lg:flex-row gap-6">

        <div class="hidden lg:block w-64 shrink-0 mt-4">
          <% if user_signed_in? %>
          <ul class="border border-gray-700 rounded divide-y divide-gray-700 text-sm">
            <li class="px-4 py-2 font-semibold bg-gray-800">Menu</li>
            <%= render partial: 'layouts/links', locals: { item_class: 'block px-4 py-2 text-gray-300 hover:bg-gray-800' } %>
          </ul>

          <div class="mt-4">
            <%= render partial: "shared/bookmarklet" %>
          </div>
          <% end %>
        </div>

        <div class="flex-1 min-w-0 mt-1 lg:mt-4">
          <%= flash_messages %>
          <%= yield %>
        </div>

      </div>

      <footer class="mt-8 py-4 text-center text-sm text-gray-500">
        &copy; <a href="http://github.com/ollej" class="hover:underline">Olle Wreede</a> 2013-2026
      </footer>
    </div>
  </body>
</html>
