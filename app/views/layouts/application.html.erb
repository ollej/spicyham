<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= content_for?(:title) ? yield(:title) : 'Spicyham' %></title>
    <%= csrf_meta_tags %>

    <%= favicon_link_tag asset_path('apple-touch-icon-144x144-precomposed.png'), :rel => 'apple-touch-icon-precomposed', :type => 'image/png', :sizes => '144x144' %>
    <%= favicon_link_tag asset_path('apple-touch-icon-114x114-precomposed.png'), :rel => 'apple-touch-icon-precomposed', :type => 'image/png', :sizes => '114x114' %>
    <%= favicon_link_tag asset_path('apple-touch-icon-72x72-precomposed.png'), :rel => 'apple-touch-icon-precomposed', :type => 'image/png', :sizes => '72x72' %>
    <%= favicon_link_tag asset_path('apple-touch-icon-precomposed.png'), :rel => 'apple-touch-icon-precomposed', :type => 'image/png' %>
    <%= favicon_link_tag asset_path('favicon.ico'), :rel => 'shortcut icon' %>

    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>
  <body class="bg-white text-gray-900">
    <nav class="bg-gray-100 shadow-sm py-2" data-controller="toggle">
      <div class="max-w-7xl mx-auto px-4 flex items-center justify-between">
        <div class="flex items-center">
          <button type="button" class="md:hidden mr-2 text-gray-600" data-action="click->toggle#toggle">
            &#x2630;
          </button>
          <a class="text-xl font-bold text-gray-800" href="<%= root_path %>">Spicyham</a>
        </div>
        <div class="hidden md:flex space-x-1" data-toggle-target="menu">
          <%= render partial: 'layouts/links', locals: { item_class: 'px-3 py-2 text-sm text-gray-700 hover:text-gray-900 hover:bg-gray-200 rounded' } %>
        </div>
      </div>
    </nav>

    <div class="max-w-7xl mx-auto px-4 mt-4">
      <div class="flex flex-col lg:flex-row gap-6">

        <div class="hidden lg:block w-64 shrink-0">
          <% if user_signed_in? %>
          <ul class="border rounded divide-y text-sm">
            <li class="px-4 py-2 font-semibold bg-gray-50">Menu</li>
            <%= render partial: 'layouts/links', locals: { item_class: 'block px-4 py-2 text-gray-700 hover:bg-gray-50' } %>
          </ul>

          <div class="mt-4">
            <%= render partial: "shared/bookmarklet" %>
          </div>
          <% end %>
        </div>

        <div class="flex-1 min-w-0">
          <%= flash_messages %>
          <%= yield %>
        </div>

      </div>

      <footer class="mt-8 py-4 text-center text-sm text-gray-400">
        &copy; <a href="http://github.com/ollej" class="hover:underline">Olle Wreede</a> 2013-2025
      </footer>
    </div>
  </body>
</html>
