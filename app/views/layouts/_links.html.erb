<% if user_signed_in? %>
  <% if current_user.admin? %>
    <%= menu_item icon("mail") + ' Emails', emails_path, class: item_class %>
    <%= menu_item icon("globe") + ' Zones', zone_path, class: item_class %>
    <%= menu_item icon("briefcase") + ' Domains', domain_path, class: item_class %>
    <%= menu_item icon("external-link") + ' Web Redirs', webredir_path, class: item_class %>
  <% end %>
  <%= menu_item icon("user") + ' Profile', edit_user_registration_path(current_user), class: item_class %>
  <%= menu_item icon("log-out") + ' Log Out', destroy_user_session_path, class: item_class, data: { turbo_method: :delete } %>
<% end %>
