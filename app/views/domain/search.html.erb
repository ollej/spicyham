<h1 class="text-2xl font-bold mb-4">Domain search result</h1>

<table class="w-full text-left text-sm">
  <thead>
    <tr class="border-b font-semibold">
      <th class="py-2">Domain</th>
      <th class="py-2">Price</th>
      <th class="py-2"></th>
    </tr>
  </thead>
  <tbody class="divide-y">
  <% @domain_info.each do |domain, price| %>
    <tr class="hover:bg-gray-50">
      <td class="py-2"><%= domain %></td>
      <td class="py-2">
        <% if price != 'unavailable' %>
          <%= number_to_currency(price['price'],
                { format: "%u %n", unit: price['currency'] }) %>
        <% end %>
      </td>
      <td class="py-2">
      <% if price == 'unavailable' %>
        <%= link_to 'Whois', "http://en.gandi.net/whois/details?search=#{domain}",
          target: '_blank', class: 'text-blue-600 hover:underline' %>
      <% else %>
        <%= link_to icon_button('Buy', :'credit-card'),
          domain_create_path + '?' + { domain: domain }.to_param,
          class: 'inline-flex items-center bg-green-600 text-white text-sm px-2 py-1 rounded hover:bg-green-700',
          data: { turbo_method: :post, turbo_confirm: "Are you sure you want to buy domain #{domain}?" } %>
      <% end %>
    </td>
  </tr>
  <% end %>
</tbody>
</table>
