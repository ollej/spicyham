<h1 class="text-2xl font-bold mb-4">Domain list</h1>
<div class="mb-4">
  <%= render 'domain_form' %>
</div>

<table class="w-full text-left text-sm">
  <thead>
    <tr class="border-b font-semibold">
      <th class="py-2">Domain</th>
      <th class="py-2">Created</th>
      <th class="py-2">Updated</th>
      <th class="py-2">Status</th>
    </tr>
  </thead>
  <tbody class="divide-y">
  <% @domains.each do |domain| %>
    <tr class="hover:bg-gray-50">
      <td class="py-2"><%= domain['fqdn'] %></td>
      <td class="py-2"><%= format_date(domain['date_created']) %></td>
      <td class="py-2"><%= format_date(domain['date_updated']) %></td>
      <td class="py-2"><%= domain['status'].join(', ') %></td>
    </tr>
  <% end %>
  </tbody>
</table>
