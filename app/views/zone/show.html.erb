<h1 class="text-2xl font-bold mb-4">Records</h1>

<div class="relative inline-block mb-4" data-controller="dropdown">
  <button type="button" class="inline-flex items-center bg-purple-600 text-white px-4 py-2 rounded hover:bg-purple-700" data-action="click->dropdown#toggle">
    <%= icon(:plus) %> New record <span class="ml-1">&#9662;</span>
  </button>
  <div class="hidden absolute z-10 mt-1 w-72 bg-gray-800 border border-gray-600 rounded shadow-lg p-4" data-dropdown-target="menu">
    <%= render "record" %>
  </div>
</div>

<table class="w-full text-left text-sm">
  <thead>
    <tr class="border-b border-gray-700 font-semibold">
      <th class="py-2">Name</th>
      <th class="py-2">Type</th>
      <th class="py-2">Value</th>
      <th class="py-2">TTL</th>
      <th class="py-2"></th>
    </tr>
  </thead>
  <tbody class="divide-y divide-gray-700">
  <% @records.each do |record| %>
    <tr class="hover:bg-gray-800">
      <td class="py-2"><%= record['name'] %></td>
      <td class="py-2"><%= record['type'] %></td>
      <td class="py-2"><%= record['value'] %></td>
      <td class="py-2"><%= record['ttl'] %></td>
      <td class="py-2">
        <%= link_to icon_button("Delete", :x, height: 16),
          delete_record_path(@zone_id, record["id"]),
          class: "inline-flex items-center bg-amber-700 text-white text-sm px-2 py-1 rounded hover:bg-amber-800",
          data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
      </td>
    </tr>
  <% end %>
  </tbody>
</table>
