<h1 class="text-2xl font-bold mb-4">Zone list</h1>
<table class="w-full text-left text-sm">
  <thead>
    <tr class="border-b font-semibold">
      <th class="py-2">Name</th>
      <th class="py-2">Updated</th>
      <th class="py-2">Version</th>
    </tr>
  </thead>
  <tbody class="divide-y">
  <% @zones.each do |zone| %>
    <tr class="hover:bg-gray-50">
      <td class="py-2"><%= link_to zone['name'], zone_show_path(zone['id']), class: 'text-blue-600 hover:underline' %></td>
      <td class="py-2"><%= format_date(zone['date_updated']) %></td>
      <td class="py-2"><%= zone['version'] %></td>
    </tr>
  <% end %>
</tbody>
</table>
