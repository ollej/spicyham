<h1 class="text-2xl font-bold mb-4">Web redirections</h1>
<table class="w-full text-left text-sm">
  <thead>
    <tr class="border-b font-semibold">
      <th class="py-2">Host</th>
      <th class="py-2">Type</th>
      <th class="py-2">URL</th>
    </tr>
  </thead>
  <tbody class="divide-y">
  <% @webredirs.each do |webredir| %>
    <tr class="hover:bg-gray-50">
      <td class="py-2"><%= webredir['host'] %></td>
      <td class="py-2"><%= webredir['type'] %></td>
      <td class="py-2"><a href="<%= webredir['url'] %>" class="text-blue-600 hover:underline"><%= webredir['url'] %></a></td>
    </tr>
  <% end %>
  </tbody>
</table>
