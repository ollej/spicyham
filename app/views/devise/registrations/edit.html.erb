<h2 class="text-2xl font-bold mb-4">Edit profile</h2>

<%= form_for(resource, as: resource_name, url: user_registration_path(resource), html: { method: :put, data: { controller: "test-api", test_api_url_value: test_api_path(format: :json) } }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="flex flex-col sm:flex-row mb-4">
    <%= f.label :email, class: "font-medium mb-1 sm:w-1/3 sm:pt-2" %><br />
    <div class="sm:w-2/3">
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "border rounded px-3 py-2 w-full" %>
    </div>
  </div>

  <div class="flex flex-col sm:flex-row mb-4">
    <%= f.label "Default forwarding email", class: "font-medium mb-1 sm:w-1/3 sm:pt-2" %><br />
    <div class="sm:w-2/3">
      <%= f.email_field :default_forward, autocomplete: "email", class: "border rounded px-3 py-2 w-full" %>
    </div>
  </div>

  <div class="flex flex-col sm:flex-row mb-4">
    <%= f.label :domain, class: "font-medium mb-1 sm:w-1/3 sm:pt-2" %><br />
    <div class="sm:w-2/3">
      <%= f.text_field :domain, class: "border rounded px-3 py-2 w-full", data: { test_api_target: "domain", action: "change->test-api#reset" } %>
    </div>
  </div>

  <div class="flex flex-col sm:flex-row mb-4">
    <%= f.label "API", class: "font-medium mb-1 sm:w-1/3 sm:pt-2" %><br />
    <div class="sm:w-2/3">
      <%= f.select :api, User.apis, { selected: resource.api_name }, { class: "border rounded px-3 py-2 w-full", data: { test_api_target: "api", action: "change->test-api#reset" } } %>
    </div>
  </div>

  <div class="flex flex-col sm:flex-row mb-4">
    <%= f.label "API User", class: "font-medium mb-1 sm:w-1/3 sm:pt-2" %><br />
    <div class="sm:w-2/3">
      <%= f.text_field :api_user, class: "border rounded px-3 py-2 w-full", data: { test_api_target: "apiUser", action: "change->test-api#reset" } %>
    </div>
  </div>

  <div class="flex flex-col sm:flex-row mb-4">
    <%= f.label "API Key", class: "font-medium mb-1 sm:w-1/3 sm:pt-2" %><br />
    <div class="sm:w-2/3">
      <%= f.text_field :api_key, class: "border rounded px-3 py-2 w-full", data: { test_api_target: "apiKey", action: "change->test-api#reset" } %>
    </div>
  </div>

  <div class="flex flex-col sm:flex-row mb-4">
    <%= f.label "Alias Template", class: "font-medium mb-1 sm:w-1/3 sm:pt-2" %><br />
    <div class="sm:w-2/3">
      <%= f.text_field :alias_template, class: "border rounded px-3 py-2 w-full" %>
    <p class="mt-1 text-xs text-gray-500">
      Template used to generate email alias. Any text that is not one of
      the replacements will be used verbatim.
      Replacements:
      <b>{DOMAIN}</b> is replaced with main part of domain.
      <b>{UUID}</b> is replaced with a UUID.
      <b>{RANDOM}</b> is replaced with a random number.
      <b>{ALPHA}</b> is replaced with random alphanumeric characters.
      <b>{HEX}</b> is replaced with a hexadecimal number.
    </p>
    </div>
  </div>

  <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
    <div>Currently waiting confirmation for: <%= resource.unconfirmed_email %></div>
  <% end %>

  <div class="flex items-center gap-2 mt-6">
    <%= button_tag type: "submit", class: "inline-flex items-center bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" do %>
      <%= icon(:check) %> Update profile
    <% end %>
    <a href="#" class="inline-flex items-center border border-gray-700 text-gray-700 px-4 py-2 rounded hover:bg-gray-100 test-api-btn" data-test-api-target="button" data-action="click->test-api#test">
      <span data-test-api-target="processing" class="test-api-icon test-api-processing hidden animate-spin" aria-hidden="true">&#9696;</span>
      <span data-test-api-target="success" class="test-api-icon test-api-success hidden text-green-600" aria-hidden="true"><%= icon("check") %></span>
      <span data-test-api-target="failed" class="test-api-icon test-api-failed hidden text-red-600" aria-hidden="true"><%= icon("alert") %></span>
      <span data-test-api-target="untested" class="test-api-icon test-api-untested text-gray-400" aria-hidden="true"><%= icon("question") %></span>
      Test API
    </a>
  </div>
<% end %>
<br>

<h3 class="text-xl font-bold mt-6 mb-2">Cancel my account</h3>

<p class="mb-2 text-sm text-gray-600">If you don't want to use this service anymore, you can cancel your account.</p>
<%= button_to delete_user_registration_path(resource_name), method: :delete,
  data: { turbo_confirm: "Are you sure?" }, class: "inline-flex items-center bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700" do %>
  <%= icon(:stop) %> Cancel my account
<% end %>
