<h2>Edit profile</h2>

<%= form_for(resource, as: resource_name, url: user_registration_path(resource), html: { method: :put, data: { controller: "test-api", test_api_url_value: test_api_path(format: :json) } }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="form-group row">
    <%= f.label :email, class: "col-sm-3 col-form-label" %><br />
    <div class="col-sm-9">
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control" %>
    </div>
  </div>

  <div class="form-group row">
    <%= f.label "Default forwarding email", class: "col-sm-3 col-form-label" %><br />
    <div class="col-sm-9">
      <%= f.email_field :default_forward, autocomplete: "email", class: "form-control" %>
    </div>
  </div>

  <div class="form-group row">
    <%= f.label :domain, class: "col-sm-3 col-form-label" %><br />
    <div class="col-sm-9">
      <%= f.text_field :domain, class: "form-control", data: { test_api_target: "domain", action: "change->test-api#reset" } %>
    </div>
  </div>

  <div class="form-group row">
    <%= f.label "API", class: "col-sm-3 col-form-label" %><br />
    <div class="col-sm-9">
      <%= f.select :api, User.apis, { selected: resource.api_name }, { class: "custom-select", data: { test_api_target: "api", action: "change->test-api#reset" } } %>
    </div>
  </div>

  <div class="form-group row">
    <%= f.label "API User", class: "col-sm-3 col-form-label" %><br />
    <div class="col-sm-9">
      <%= f.text_field :api_user, class: "form-control", data: { test_api_target: "apiUser", action: "change->test-api#reset" } %>
    </div>
  </div>

  <div class="form-group row">
    <%= f.label "API Key", class: "col-sm-3 col-form-label" %><br />
    <div class="col-sm-9">
      <%= f.text_field :api_key, class: "form-control", data: { test_api_target: "apiKey", action: "change->test-api#reset" } %>
    </div>
  </div>

  <div class="form-group row">
    <%= f.label "Alias Template", class: "col-sm-3 col-form-label" %><br />
    <div class="col-sm-9">
      <%= f.text_field :alias_template, class: "form-control" %>
    <small>
      <p>
      Template used to generate email alias. Any text that is not one of
      the replacements will be used verbatim.
      Replacements:
      <b>{DOMAIN}</b> is replaced with main part of domain.
      <b>{UUID}</b> is replaced with a UUID.
      <b>{RANDOM}</b> is replaced with a random number.
      <b>{ALPHA}</b> is replaced with random alphanumeric characters.
      <b>{HEX}</b> is replaced with a hexadecimal number.
      </p>
    </small>
    </div>
  </div>

  <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
    <div>Currently waiting confirmation for: <%= resource.unconfirmed_email %></div>
  <% end %>

  <div class="actions">
    <%= button_tag type: "submit", class: "btn btn-primary" do %>
      <%= icon(:check) %> Update profile
    <% end %>
    <a href="#" class="btn btn-black btn-outline-dark test-api-btn" data-test-api-target="button" data-action="click->test-api#test">
      <span data-test-api-target="processing" class="test-api-icon test-api-processing d-none spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
      <span data-test-api-target="success" class="test-api-icon test-api-success d-none" aria-hidden="true"><%= icon("check") %></span>
      <span data-test-api-target="failed" class="test-api-icon test-api-failed d-none" aria-hidden="true"><%= icon("alert") %></span>
      <span data-test-api-target="untested" class="test-api-icon test-api-untested" aria-hidden="true"><%= icon("question") %></span>
      Test API
    </a>
  </div>
<% end %>
<br>

<h3>Cancel my account</h3>

<p>If you don't want to use this service anymore, you can cancel your account.</p>
<%= button_to delete_user_registration_path(resource_name), method: :delete,
  data: { turbo_confirm: "Are you sure?" }, class: "btn btn-danger" do %>
  <%= icon(:stop) %> Cancel my account
<% end %>
