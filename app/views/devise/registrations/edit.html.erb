<h2 class="text-2xl font-bold mb-4">Edit profile</h2>

<%= form_for(resource, as: resource_name, url: user_registration_path(resource), html: { method: :put, data: { controller: "test-api", test_api_url_value: test_api_path(format: :json) } }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="flex flex-col sm:flex-row mb-4">
    <%= f.label :email, class: "font-medium mb-1 sm:w-1/3 sm:pt-2" %><br />
    <div class="sm:w-2/3">
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "bg-gray-800 border border-gray-600 text-gray-100 rounded px-3 py-2 w-full" %>
    </div>
  </div>

  <div class="flex flex-col sm:flex-row mb-4">
    <%= f.label "Default forwarding email", class: "font-medium mb-1 sm:w-1/3 sm:pt-2" %><br />
    <div class="sm:w-2/3">
      <%= f.email_field :default_forward, autocomplete: "email", class: "bg-gray-800 border border-gray-600 text-gray-100 rounded px-3 py-2 w-full" %>
    </div>
  </div>

  <div class="flex flex-col sm:flex-row mb-4">
    <%= f.label :domain, class: "font-medium mb-1 sm:w-1/3 sm:pt-2" %><br />
    <div class="sm:w-2/3">
      <%= f.text_field :domain, class: "bg-gray-800 border border-gray-600 text-gray-100 rounded px-3 py-2 w-full", data: { test_api_target: "domain", action: "change->test-api#reset" } %>
    </div>
  </div>

  <div class="flex flex-col sm:flex-row mb-4">
    <%= f.label "API", class: "font-medium mb-1 sm:w-1/3 sm:pt-2" %><br />
    <div class="sm:w-2/3">
      <%= f.select :api, User.apis, { selected: resource.api_name }, { class: "bg-gray-800 border border-gray-600 text-gray-100 rounded px-3 py-2 w-full", data: { test_api_target: "api", action: "change->test-api#reset" } } %>
    </div>
  </div>

  <div class="flex flex-col sm:flex-row mb-4">
    <%= f.label "API User", class: "font-medium mb-1 sm:w-1/3 sm:pt-2" %><br />
    <div class="sm:w-2/3">
      <%= f.text_field :api_user, class: "bg-gray-800 border border-gray-600 text-gray-100 rounded px-3 py-2 w-full", data: { test_api_target: "apiUser", action: "change->test-api#reset" } %>
    </div>
  </div>

  <div class="flex flex-col sm:flex-row mb-4">
    <%= f.label "API Key", class: "font-medium mb-1 sm:w-1/3 sm:pt-2" %><br />
    <div class="sm:w-2/3">
      <%= f.text_field :api_key, class: "bg-gray-800 border border-gray-600 text-gray-100 rounded px-3 py-2 w-full", data: { test_api_target: "apiKey", action: "change->test-api#reset" } %>
    </div>
  </div>

  <div class="flex flex-col sm:flex-row mb-4">
    <%= f.label "Alias Template", class: "font-medium mb-1 sm:w-1/3 sm:pt-2" %><br />
    <div class="sm:w-2/3">
      <%= f.text_field :alias_template, class: "bg-gray-800 border border-gray-600 text-gray-100 rounded px-3 py-2 w-full" %>
    <p class="mt-1 text-xs text-gray-500">
      Template used to generate email alias. Any text that is not one of
      the replacements will be used verbatim.
      Replacements:
      <b>{DOMAIN}</b> is replaced with main part of domain.
      <b>{UUID}</b> is replaced with a UUID.
      <b>{RANDOM}</b> is replaced with a random number.
      <b>{ALPHA}</b> is replaced with random alphanumeric characters.
      <b>{HEX}</b> is replaced with a hexadecimal number.
    </p>
    </div>
  </div>

  <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
    <div>Currently waiting confirmation for: <%= resource.unconfirmed_email %></div>
  <% end %>

  <div class="flex items-center gap-2 mt-6">
    <%= button_tag type: "submit", class: "inline-flex items-center bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" do %>
      <%= icon("check") %> Update profile
    <% end %>
    <a href="#" class="inline-flex items-center border border-gray-600 text-gray-300 px-4 py-2 rounded hover:bg-gray-800 test-api-btn" data-test-api-target="button" data-action="click->test-api#test">
      <span data-test-api-target="processing" class="test-api-icon test-api-processing hidden animate-spin" aria-hidden="true">&#9696;</span>
      <span data-test-api-target="success" class="test-api-icon test-api-success hidden text-green-600" aria-hidden="true"><%= icon("check") %></span>
      <span data-test-api-target="failed" class="test-api-icon test-api-failed hidden text-red-600" aria-hidden="true"><%= icon("alert-triangle") %></span>
      <span data-test-api-target="untested" class="test-api-icon test-api-untested text-gray-400" aria-hidden="true"><%= icon("help-circle") %></span>
      Test API
    </a>
  </div>
<% end %>
<br>

<div data-controller="confirm-delete" data-confirm-delete-phrase-value="DELETE">
  <h3 class="text-xl font-bold mt-6 mb-2">Cancel my account</h3>

  <p class="mb-2 text-sm text-gray-400">If you don't want to use this service anymore, you can cancel your account.</p>
  <button type="button" class="inline-flex items-center bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700"
    data-action="click->confirm-delete#reveal">
    <%= icon("ban") %> Cancel my account
  </button>

  <dialog data-confirm-delete-target="dialog" class="bg-gray-800 text-gray-100 rounded-lg p-6 shadow-xl backdrop:bg-black/70 max-w-md">
    <h4 class="text-lg font-semibold text-red-400 mb-2">Confirm account deletion</h4>
    <p class="text-sm text-red-300 font-medium mb-2">This action cannot be undone. Your account will be permanently removed. Your email aliases will remain stored with your email provider.</p>
    <p class="text-sm text-gray-400 mb-4">Type <b>DELETE</b> to confirm:</p>
    <input type="text" data-confirm-delete-target="input" data-action="input->confirm-delete#verify"
      class="bg-gray-700 border border-gray-600 text-gray-100 rounded px-3 py-2 text-sm w-full mb-4" autocomplete="off" placeholder="DELETE">
    <div class="flex items-center justify-end gap-2">
      <button type="button" class="inline-flex items-center px-4 py-2 text-sm text-gray-300 border border-gray-600 rounded hover:bg-gray-700"
        data-action="click->confirm-delete#cancel">
        <%= icon("x", height: 16) %> Cancel
      </button>
      <%= button_to delete_user_registration_path(resource_name), method: :delete,
        data: { confirm_delete_target: "submit" }, disabled: true,
        class: "inline-flex items-center bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700 disabled:opacity-50 disabled:cursor-not-allowed text-sm" do %>
        <%= icon("trash-2", height: 16) %> Confirm deletion
      <% end %>
    </div>
  </dialog>
</div>
